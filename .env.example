# Website + persistent worker (Render private DB URL); VPS gateway uses external TLS DB URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/resonance
DATABASE_SSL=true
APP_ORIGIN=https://your-dashboard.onrender.com
# Generate independently using openssl rand -hex 32. Never use NEXT_PUBLIC_ for secrets.
SESSION_SECRET=
NODE_RENDER_URL=https://your-render-node.onrender.com
NODE_VPS_URL=https://audio.example.com
MONITOR_RENDER_TOKEN=
MONITOR_VPS_TOKEN=
# Gateway: one of render or vps; use a distinct internal password on each machine.
NODE_ID=render
LAVALINK_SERVER_PASSWORD=
MONITOR_TOKEN=
PORT=10000
SERVER_PORT=2333
# Optional, off by default; public HTTP audio sources can expose internal network resources.
LAVALINK_HTTP_ENABLED=false
# Bot / live test only
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
BOT_OWNER_ID=
LAVALINK_URL=https://your-render-node.onrender.com
LAVALINK_CLIENT_KEY=
TEST_TRACK_IDENTIFIER=
TEST_SEARCH_IDENTIFIER=ytsearch:royalty free music
TEST_PLAYLIST_IDENTIFIER=
TEST_EXCEPTION_IDENTIFIER=
PLAYBACK_REPORT_DIR=playback-results
